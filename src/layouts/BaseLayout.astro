---
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const t = useTranslations(locale);
const alternateLocale = locale === 'pt-br' ? 'en' : 'pt-br';
const alternateLabel = locale === 'pt-br' ? 'English' : 'Português (Brasil)';
const alternateHref = getRelativeLocaleUrl(alternateLocale);
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1416" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let theme = 'dark';

        try {
          const savedTheme = localStorage.getItem('theme');
          if (savedTheme === 'light' || savedTheme === 'dark') theme = savedTheme;
        } catch {}

        root.classList.remove('light', 'dark');
        root.classList.add(theme);
      })();
    </script>
  </head>
  <body id="top" class="min-h-screen bg-background text-on-background antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-3">
      {t('skip')}
    </a>
    <header class="site-header sticky top-0 z-30" data-scroll-header>
      <div class="mx-auto flex w-full max-w-[90rem] flex-wrap items-center justify-between gap-x-3 gap-y-2 px-5 pt-4 pb-3 sm:px-8 sm:pt-5">
        <a class="flex min-h-11 items-center rounded-lg text-base font-semibold tracking-tight sm:text-lg" href={getRelativeLocaleUrl(locale)}>
          Escudo 60+
        </a>
        <div class="flex items-center gap-1.5 text-sm sm:ml-auto">
          <a
            aria-label={alternateLabel}
            class="inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-xl border border-outline-variant bg-surface-container-low px-2.5 font-medium text-on-surface hover:border-primary hover:bg-primary-container hover:text-on-primary-container"
            href={alternateHref}
            lang={alternateLocale}
          >
            {alternateLocale === 'en' ? 'EN' : 'PT-BR'}
          </a>
          <button
            aria-label={t('themeLight')}
            class="grid size-11 shrink-0 cursor-pointer place-items-center rounded-xl border border-outline-variant bg-surface-container-low text-on-surface hover:border-primary hover:bg-primary-container hover:text-on-primary-container"
            data-theme-toggle
            data-light-label={t('themeLight')}
            data-dark-label={t('themeDark')}
            title={t('themeLight')}
            type="button"
          >
            <svg class="hidden size-4 dark:block" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.75">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
            </svg>
            <svg class="size-4 dark:hidden" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75">
              <path d="M20.9 13.1A8.5 8.5 0 0 1 10.9 3.1a8.5 8.5 0 1 0 10 10Z" />
            </svg>
          </button>
        </div>
        <nav aria-label={t('navigation')} class="flex w-full flex-wrap items-center justify-center gap-1 rounded-2xl border border-outline-variant/75 bg-surface-container-low/85 p-1.5 text-sm shadow-lg shadow-shadow/10 backdrop-blur-md sm:w-auto">
          <a class="inline-flex min-h-11 items-center rounded-xl px-2.5 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface sm:px-3" href="#projeto">
            {t('project')}
          </a>
          <a class="inline-flex min-h-11 items-center rounded-xl px-2.5 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface sm:px-3" href="#como-funciona">
            {t('how')}
          </a>
          <a class="inline-flex min-h-11 items-center rounded-xl bg-primary px-3 font-semibold text-on-primary hover:bg-primary/90 sm:px-4" href="#exemplo">
            {t('example')}
          </a>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="border-t border-outline-variant">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-6 py-5 text-sm text-on-surface-variant sm:px-8">
        <span class="font-semibold text-on-surface">Escudo 60+</span>
        <a class="inline-flex min-h-11 items-center gap-2 rounded-sm text-primary hover:underline" href="#top">
          {t('backToTop')} <span aria-hidden="true">↑</span>
        </a>
      </div>
    </footer>
    <script>
      const header = document.querySelector<HTMLElement>('[data-scroll-header]');

      if (header) {
        let lastScrollY = Math.max(0, window.scrollY);

        const updateHeader = () => {
          const scrollY = Math.max(0, window.scrollY);
          header.toggleAttribute('data-scrolled', scrollY > 0);

          if (scrollY === 0 || scrollY < lastScrollY) {
            header.removeAttribute('data-hidden');
          } else if (scrollY > lastScrollY) {
            header.setAttribute('data-hidden', '');
          }

          lastScrollY = scrollY;
        };

        updateHeader();
        window.addEventListener('scroll', updateHeader, { passive: true });
      }

      const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const themeColorMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

      if (themeToggle) {
        const setTheme = (theme: 'light' | 'dark', persist = false) => {
          const root = document.documentElement;
          root.classList.toggle('light', theme === 'light');
          root.classList.toggle('dark', theme === 'dark');

          const actionLabel = theme === 'dark' ? themeToggle.dataset.lightLabel : themeToggle.dataset.darkLabel;
          if (actionLabel) {
            themeToggle.setAttribute('aria-label', actionLabel);
            themeToggle.title = actionLabel;
          }

          if (themeColorMeta) {
            themeColorMeta.content = getComputedStyle(root).getPropertyValue('--md-sys-color-background').trim();
          }

          if (persist) {
            try {
              localStorage.setItem('theme', theme);
            } catch {}
          }
        };

        setTheme(document.documentElement.classList.contains('dark') ? 'dark' : 'light');
        themeToggle.addEventListener('click', () => {
          const nextTheme = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
          setTheme(nextTheme, true);
        });
      }
    </script>
  </body>
</html>

<style>
  .site-header[data-scrolled] {
    background: color-mix(in srgb, var(--md-sys-color-background) 92%, transparent);
    backdrop-filter: blur(14px);
  }

  .site-header[data-hidden]:not(:has(:focus-visible)) {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      transition: transform 180ms ease, opacity 180ms ease;
    }
  }
</style>
