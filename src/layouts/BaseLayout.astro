---
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { useTranslations, type Locale } from '../i18n/ui';
import { landingContent } from '../i18n/landing';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  page?: 'home' | 'team' | 'project';
}

const { locale, title, description, page = 'home' } = Astro.props;
const t = useTranslations(locale);
const footer = landingContent[locale].footer;
const alternateLocale = locale === 'pt-br' ? 'en' : 'pt-br';
const alternateLabel = locale === 'pt-br' ? 'English' : 'Português (Brasil)';
const alternatePath = page === 'team'
  ? (alternateLocale === 'pt-br' ? 'quem-somos/' : 'about-us/')
  : page === 'project'
    ? (alternateLocale === 'pt-br' ? 'sobre-o-projeto/' : 'about-the-project/')
    : '';
const alternateHref = getRelativeLocaleUrl(alternateLocale, alternatePath);
const homeHref = getRelativeLocaleUrl(locale);
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1416" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let theme = 'dark';

        try {
          const savedTheme = localStorage.getItem('theme');
          if (savedTheme === 'light' || savedTheme === 'dark') theme = savedTheme;
        } catch {}

        root.classList.remove('light', 'dark');
        root.classList.add(theme);
      })();
    </script>
  </head>
  <body id="top" class="min-h-screen bg-background text-on-background antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-3">
      {t('skip')}
    </a>
    <header class="site-header sticky top-0 z-30" data-scroll-header>
      <div class="mx-auto w-full max-w-[90rem] px-5 pt-4 pb-3 sm:px-8 sm:pt-5">
        <div class="header-panel flex flex-wrap items-center justify-between gap-x-3 gap-y-2 rounded-2xl border border-outline-variant bg-surface-container-low/95 p-2 shadow-lg shadow-shadow/10 backdrop-blur-md sm:px-3">
          <a data-reveal class="flex min-h-11 items-center rounded-lg px-2 text-base font-semibold tracking-tight sm:px-3 sm:text-lg" href={getRelativeLocaleUrl(locale)}>
            DOld
          </a>
          <nav id="header-navigation" aria-label={t('navigation')} class="mobile-navigation order-2 flex w-full flex-wrap items-center justify-center gap-1 border-t border-outline-variant/60 pt-2 text-sm sm:order-1 sm:ml-auto sm:w-auto sm:border-t-0 sm:pt-0">
            <a aria-current={page === 'team' ? 'page' : undefined} class="inline-flex min-h-11 items-center rounded-xl px-2.5 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface sm:px-3" href={getRelativeLocaleUrl(locale, locale === 'pt-br' ? 'quem-somos/' : 'about-us/')}>
              {t('whoWeAre')}
            </a>
            <a aria-current={page === 'project' ? 'page' : undefined} class="inline-flex min-h-11 items-center rounded-xl px-2.5 text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface sm:px-3" href={getRelativeLocaleUrl(locale, locale === 'pt-br' ? 'sobre-o-projeto/' : 'about-the-project/')}>
              {t('aboutProject')}
            </a>
          </nav>
          <div data-reveal class="order-1 ml-auto flex items-center gap-1.5 text-sm sm:order-2 sm:ml-0">
            <a
              aria-label={alternateLabel}
              class="inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-xl border border-outline-variant bg-surface-container-low px-2.5 font-medium text-on-surface hover:border-primary hover:bg-primary-container hover:text-on-primary-container"
              href={alternateHref}
              lang={alternateLocale}
            >
              {alternateLocale === 'en' ? 'EN' : 'PT-BR'}
            </a>
            <button
              aria-label={t('themeLight')}
              class="grid size-11 shrink-0 cursor-pointer place-items-center rounded-xl border border-outline-variant bg-surface-container-low text-on-surface hover:border-primary hover:bg-primary-container hover:text-on-primary-container"
              data-theme-toggle
              data-light-label={t('themeLight')}
              data-dark-label={t('themeDark')}
              title={t('themeLight')}
              type="button"
            >
              <svg class="hidden size-4 dark:block" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.75">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
              </svg>
              <svg class="size-4 dark:hidden" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75">
                <path d="M20.9 13.1A8.5 8.5 0 0 1 10.9 3.1a8.5 8.5 0 1 0 10 10Z" />
              </svg>
            </button>
            <button
              type="button"
              class="menu-toggle grid size-11 shrink-0 cursor-pointer place-items-center rounded-xl border border-outline-variant bg-surface-container-low text-on-surface hover:border-primary hover:bg-primary-container hover:text-on-primary-container"
              aria-controls="header-navigation"
              aria-expanded="false"
              aria-label={locale === 'pt-br' ? 'Abrir menu' : 'Open menu'}
              data-open-label={locale === 'pt-br' ? 'Abrir menu' : 'Open menu'}
              data-close-label={locale === 'pt-br' ? 'Fechar menu' : 'Close menu'}
            >
              <svg class="menu-open-icon size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
                <path d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <svg class="menu-close-icon size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
                <path d="m6 6 12 12M6 18 18 6" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="mx-auto max-w-[84rem] px-6 sm:px-8 lg:px-12">
      <div class="grid gap-7 border-t border-outline-variant pt-8 pb-12 text-on-surface-variant md:grid-cols-2 md:items-end md:pb-16">
        <div>
          <p data-reveal class="text-base">{footer.title}</p>
          <p data-reveal class="mt-7 text-xs leading-relaxed">{footer.description}</p>
        </div>
        <div class="md:justify-self-end">
          <nav data-reveal aria-label={footer.navigation}>
            <ul class="flex flex-wrap items-center gap-x-5 text-base">
              <li><a class="inline-flex min-h-11 items-center hover:text-primary hover:underline" href={getRelativeLocaleUrl(locale, locale === 'pt-br' ? 'sobre-o-projeto/' : 'about-the-project/')}>{footer.project}</a></li>
              <li aria-hidden="true">/</li>
              <li><a class="inline-flex min-h-11 items-center hover:text-primary hover:underline" href={`${homeHref}#como-funciona`}>{footer.how}</a></li>
              <li aria-hidden="true">/</li>
              <li><a class="inline-flex min-h-11 items-center hover:text-primary hover:underline" href={`${homeHref}#duvidas`}>{footer.faq}</a></li>
            </ul>
          </nav>
          <p data-reveal class="mt-3 text-xs leading-relaxed">{footer.note}</p>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/scroll-reveal';

      const header = document.querySelector<HTMLElement>('[data-scroll-header]');

      const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('#header-navigation');

      if (header && menuToggle && navigation) {
        const setMenuOpen = (open: boolean) => {
          menuToggle.setAttribute('aria-expanded', String(open));
          menuToggle.setAttribute('aria-label', (open ? menuToggle.dataset.closeLabel : menuToggle.dataset.openLabel) ?? 'Menu');
          header.toggleAttribute('data-menu-open', open);
        };

        header.setAttribute('data-menu-ready', '');
        menuToggle.addEventListener('click', () => setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true'));
        navigation.addEventListener('click', (event) => {
          if (event.target instanceof Element && event.target.closest('a')) setMenuOpen(false);
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menuToggle.getAttribute('aria-expanded') === 'true') {
            setMenuOpen(false);
            menuToggle.focus();
          }
        });
        document.addEventListener('click', (event) => {
          if (event.target instanceof Node && !header.contains(event.target)) setMenuOpen(false);
        });
        window.matchMedia('(min-width: 640px)').addEventListener('change', () => setMenuOpen(false));
      }

      if (header) {
        let lastScrollY = Math.max(0, window.scrollY);

        const updateHeader = () => {
          const scrollY = Math.max(0, window.scrollY);
          header.toggleAttribute('data-scrolled', scrollY > 0);

          if (header.hasAttribute('data-menu-open') || scrollY === 0 || scrollY < lastScrollY) {
            header.removeAttribute('data-hidden');
          } else if (scrollY > lastScrollY) {
            header.setAttribute('data-hidden', '');
          }

          lastScrollY = scrollY;
        };

        updateHeader();
        window.addEventListener('scroll', updateHeader, { passive: true });
      }

      const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const themeColorMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

      if (themeToggle) {
        const setTheme = (theme: 'light' | 'dark', persist = false) => {
          const root = document.documentElement;
          root.classList.toggle('light', theme === 'light');
          root.classList.toggle('dark', theme === 'dark');

          const actionLabel = theme === 'dark' ? themeToggle.dataset.lightLabel : themeToggle.dataset.darkLabel;
          if (actionLabel) {
            themeToggle.setAttribute('aria-label', actionLabel);
            themeToggle.title = actionLabel;
          }

          if (themeColorMeta) {
            themeColorMeta.content = getComputedStyle(root).getPropertyValue('--md-sys-color-background').trim();
          }

          if (persist) {
            try {
              localStorage.setItem('theme', theme);
            } catch {}
          }
        };

        setTheme(document.documentElement.classList.contains('dark') ? 'dark' : 'light');
        themeToggle.addEventListener('click', () => {
          const nextTheme = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
          setTheme(nextTheme, true);
        });
      }
    </script>
  </body>
</html>

<style>
  .mobile-navigation a[aria-current='page'] {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  .menu-toggle,
  .menu-close-icon {
    display: none;
  }

  @media (width < 640px) {
    [data-menu-ready] .menu-toggle {
      display: grid;
    }

    [data-menu-ready]:not([data-menu-open]) .mobile-navigation {
      display: none;
    }

    .mobile-navigation {
      flex-direction: column;
      align-items: stretch;
    }

    .mobile-navigation a {
      justify-content: center;
    }

    [data-menu-open] .menu-open-icon {
      display: none;
    }

    [data-menu-open] .menu-close-icon {
      display: block;
    }
  }

  .site-header[data-scrolled] .header-panel {
    background: color-mix(in srgb, var(--md-sys-color-surface-container-low) 98%, transparent);
  }

  .site-header[data-hidden]:not([data-menu-open]):not(:has(:focus-visible)) {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      transition: transform 180ms ease, opacity 180ms ease;
    }
  }
</style>
