---
import { landingContent } from '../i18n/landing';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = landingContent[locale];
const signalIcons = [
  'M12 8v4l3 2 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  'M7 10V7a5 5 0 0 1 10 0v3 M6 10h12v11H6Z M12 14v3',
  'm10 13 4-4 M8 16l-1 1a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0 M13 17a4 4 0 0 0 6 0l4-4a4 4 0 0 0-6-6l-1 1',
  'M15 21v-2a5 5 0 0 0-10 0v2 M14 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z M18 8a3 3 0 0 1 0 6 M19 17a4 4 0 0 1 3 4',
];
---

<div class="text-on-surface">
  <section id="como-funciona" aria-labelledby="how-title" class="chapter bg-background">
    <div class="section-container py-16 md:py-20">
      <p data-reveal class="eyebrow">{content.how.label}</p>
      <h2 data-reveal id="how-title" class="section-title">{content.how.title}</h2>
      <p data-reveal class="section-description">{content.how.description}</p>
      <ol class="mt-9 grid gap-6 md:grid-cols-3">
        {content.how.steps.map((step, index) => (
          <li data-reveal class="flex flex-col rounded-[1.125rem] border border-outline-variant bg-surface-container-low p-5 dark:border-primary/20 lg:p-6">
            <span class="text-[2rem] leading-none font-medium text-primary" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-6 text-[1.375rem] leading-snug font-semibold">{step.title}</h3>
            <p class="mt-2 mb-4 text-base leading-relaxed text-on-surface-variant lg:text-[1.0625rem]">{step.description}</p>
            <div class="mt-auto rounded-xl bg-primary/10 px-3 py-3">
              <p class="text-[0.625rem] leading-relaxed font-semibold tracking-wide text-primary uppercase">{step.label}</p>
              <p class="mt-1 text-sm leading-relaxed">{step.example}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="signals-title" class="border-y border-outline-variant bg-surface-container dark:border-outline-variant/60">
    <div class="section-container py-16 md:py-20">
      <p data-reveal class="eyebrow">{content.signals.label}</p>
      <h2 data-reveal id="signals-title" class="section-title">{content.signals.title}</h2>
      <p data-reveal class="section-description">{content.signals.description}</p>
      <ul class="mt-9 grid gap-5 md:grid-cols-2">
        {content.signals.items.map((signal, index) => (
          <li data-reveal class="flex items-start gap-5 rounded-[1.125rem] border border-outline-variant bg-surface-container-lowest p-5 dark:border-primary/20 dark:bg-background lg:p-6">
            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-primary/10 text-primary">
              <svg aria-hidden="true" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={signalIcons[index]} />
              </svg>
            </span>
            <div>
              <h3 class="text-xl leading-snug font-semibold lg:text-[1.375rem]">{signal.title}</h3>
              <p class="mt-3 max-w-[47ch] text-base leading-relaxed text-on-surface-variant lg:text-[1.0625rem]">{signal.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="exemplo" aria-labelledby="example-title" class="chapter border-b border-primary/45 bg-primary-container dark:border-primary/20 dark:bg-primary-container/30">
    <div class="section-container py-16 md:py-20">
      <div class="rounded-[1.75rem] border border-primary/50 bg-surface-container-lowest p-6 dark:border-primary/30 dark:bg-surface-container-low md:p-10">
        <div class="grid gap-9 md:grid-cols-[1fr_1.15fr] md:gap-12">
          <div class="md:pr-1">
            <p data-reveal class="eyebrow">{content.example.label}</p>
            <h2 data-reveal id="example-title" class="section-title">
              {content.example.title.map((line) => <span class="block">{line}</span>)}
            </h2>
            <p data-reveal class="section-description max-w-[35ch]">{content.example.description}</p>
            <figure data-reveal class="mt-9">
              <div class="rounded-2xl bg-primary/15 p-5">
                <p class="text-[0.625rem] leading-relaxed font-semibold tracking-wide text-primary uppercase">{content.example.messageLabel}</p>
                <blockquote class="mt-3 max-w-[36ch] text-lg leading-relaxed">{content.example.message}</blockquote>
              </div>
            </figure>
          </div>
          <div class="border-t border-primary/35 pt-8 text-center md:border-t-0 md:border-l md:pt-2 md:pl-12">
            <p data-reveal class="eyebrow">{content.example.explanationLabel}</p>
            <div data-example-carousel data-reveal class="example-carousel mt-9" role="group" aria-label={content.example.explanationLabel}>
              <ol class="carousel-slides grid gap-6" aria-live="off">
                {content.example.explanations.map((explanation, index) => (
                  <li data-carousel-slide class="rounded-2xl border border-primary/25 bg-primary/5 p-5 sm:p-6">
                    <span class="inline-flex items-center gap-2 text-sm font-medium text-primary">
                      {content.example.stepLabel} <span class="text-2xl font-semibold">{String(index + 1).padStart(2, '0')}</span>
                    </span>
                    <h3 class="mt-5 text-xl leading-snug font-semibold sm:text-2xl">{explanation.title}</h3>
                    <p class="mx-auto mt-3 max-w-[38ch] text-base leading-relaxed text-on-surface-variant sm:text-lg">{explanation.description}</p>
                  </li>
                ))}
              </ol>
              <div data-carousel-controls hidden class="mt-5 items-center justify-center gap-3">
                <div class="flex gap-2">
                  {content.example.explanations.map((explanation, index) => (
                    <button
                      type="button"
                      data-carousel-select={index}
                      aria-label={`${content.example.stepLabel} ${index + 1}: ${explanation.title}`}
                      aria-pressed={index === 0 ? 'true' : 'false'}
                      class="carousel-select grid size-11 cursor-pointer place-items-center rounded-full border border-primary/35 text-sm font-semibold"
                    >{index + 1}</button>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="duvidas" aria-labelledby="faq-title" class="chapter border-b border-outline-variant bg-surface-container-low dark:border-outline-variant/60">
    <div class="section-container grid gap-9 py-16 md:grid-cols-[0.9fr_1.1fr] md:gap-16 md:py-20">
      <div class="md:self-center">
        <p data-reveal class="eyebrow">{content.faq.label}</p>
        <h2 data-reveal id="faq-title" class="section-title">
          {content.faq.title.map((line) => <span class="block">{line}</span>)}
        </h2>
        <p data-reveal class="section-description max-w-[26ch]">{content.faq.description}</p>
      </div>
      <dl>
        {content.faq.items.map((item) => (
          <div data-reveal class="border-b border-outline-variant py-5 first:pt-0">
            <dt class="text-lg leading-snug font-semibold">{item.question}</dt>
            <dd class="mt-3 max-w-[60ch] text-base leading-relaxed text-on-surface-variant lg:text-[1.0625rem]">{item.answer}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="bg-background">
    <div class="section-container py-16 md:py-20">
      <section aria-labelledby="closing-title" class="rounded-[1.75rem] bg-primary-fixed-dim p-6 text-on-primary-fixed md:p-10">
        <p data-reveal class="text-xs leading-relaxed font-semibold uppercase">{content.closing.label}</p>
        <div class="mt-5 grid items-center gap-x-12 gap-y-7 lg:grid-cols-[minmax(0,1fr)_auto]">
          <h2 data-reveal id="closing-title" class="min-w-0 text-[clamp(1.875rem,3.2vw,3rem)] leading-[1.12] font-semibold tracking-[-0.025em]">
            {content.closing.title.map((line) => <span class="block">{line}</span>)}
          </h2>
          <p data-reveal class="min-w-0 text-base leading-relaxed lg:col-start-1 lg:row-start-2 lg:text-lg">{content.closing.description}</p>
          <a data-reveal href="#como-funciona" class="inline-flex min-h-14 items-center justify-center gap-3 justify-self-start rounded-xl bg-on-primary-fixed px-6 py-3 text-sm font-semibold text-primary-fixed hover:bg-on-primary-fixed/90 lg:col-start-2 lg:row-start-1">
            <span class="-translate-y-px leading-5">{content.closing.action}</span>
            <svg aria-hidden="true" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 19V5m-6 6 6-6 6 6" />
            </svg>
          </a>
        </div>
      </section>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-example-carousel]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const selectors = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-select]'));
    const controls = carousel.querySelector<HTMLElement>('[data-carousel-controls]');
    if (slides.length < 2 || !controls) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let hovered = false;
    let focused = false;
    let inView = false;
    let timer: number | undefined;

    const showSlide = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === current;
        slide.toggleAttribute('data-active', active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      selectors.forEach((button, index) => button.setAttribute('aria-pressed', String(index === current)));
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (reducedMotion.matches || hovered || focused || !inView || document.hidden) return;
      timer = window.setTimeout(() => {
        showSlide(current + 1);
        schedule();
      }, 6000);
    };

    selectors.forEach((button, index) => button.addEventListener('click', () => {
      showSlide(index);
      schedule();
    }));
    carousel.addEventListener('mouseenter', () => { hovered = true; schedule(); });
    carousel.addEventListener('mouseleave', () => { hovered = false; schedule(); });
    carousel.addEventListener('focusin', () => { focused = true; schedule(); });
    carousel.addEventListener('focusout', (event) => {
      focused = event.relatedTarget instanceof Node && carousel.contains(event.relatedTarget);
      schedule();
    });
    document.addEventListener('visibilitychange', schedule);
    reducedMotion.addEventListener('change', schedule);

    showSlide(0);
    carousel.setAttribute('data-carousel-ready', '');
    controls.hidden = false;

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        schedule();
      }, { threshold: 0.2 });
      observer.observe(carousel);
    } else {
      inView = true;
      schedule();
    }
  });
</script>

<style>
  [data-carousel-controls]:not([hidden]) {
    display: flex;
  }

  [data-carousel-ready] .carousel-slides {
    gap: 0;
  }

  [data-carousel-ready] [data-carousel-slide] {
    grid-area: 1 / 1;
    align-self: stretch;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    translate: 1rem 0;
  }

  [data-carousel-ready] [data-carousel-slide][data-active] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    translate: none;
  }

  .carousel-select[aria-pressed='true'] {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }

  .carousel-select[aria-pressed='false'] {
    color: var(--md-sys-color-primary);
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-carousel-ready] [data-carousel-slide] {
      transition: opacity 450ms ease, translate 450ms ease, visibility 450ms;
    }
  }

  .section-container {
    width: 100%;
    max-width: 84rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  @media (width >= 40rem) {
    .section-container {
      padding-inline: 2rem;
    }
  }

  @media (width >= 64rem) {
    .section-container {
      padding-inline: 3rem;
    }
  }

  .chapter {
    scroll-margin-top: 8rem;
  }

  .eyebrow {
    color: var(--md-sys-color-primary);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .section-title {
    margin-top: 1.25rem;
    font-size: clamp(1.875rem, 3vw, 2.75rem);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.025em;
    overflow-wrap: break-word;
  }

  .section-description {
    margin-top: 1.25rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 1.125rem;
    line-height: 1.6;
  }
</style>
