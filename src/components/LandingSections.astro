---
import { landingContent } from '../i18n/landing';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = landingContent[locale];
const previousSignal = locale === 'pt-br' ? 'Anterior' : 'Previous';
const nextSignal = locale === 'pt-br' ? 'Próximo' : 'Next';
const assetBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/`;
const exampleBackground = `${assetBase}old.jpeg`;
const signalImages = [
  { file: 'pressao.avif', width: 984, height: 764 },
  { file: 'senha.webp', width: 984, height: 554 },
  { file: 'cobranca.jpeg', width: 973, height: 693 },
  { file: 'fake.jpeg', width: 875, height: 662 },
];
---

<div class="text-on-surface">
  <section aria-labelledby="signals-title" class="border-y border-outline-variant bg-surface-container dark:border-outline-variant/60">
    <div class="section-container py-16 md:py-20">
      <div class="mx-auto max-w-3xl text-center">
        <p data-reveal class="eyebrow">{content.signals.label}</p>
        <h2 data-reveal id="signals-title" class="section-title">{content.signals.title}</h2>
        <p data-reveal class="section-description">{content.signals.description}</p>
      </div>
      <div class="signals-slider mt-9" data-signals-slider>
        <ul id="signals-slides" class="signals-track" data-signals-track role="list" aria-labelledby="signals-title" tabindex="0">
          {content.signals.items.map((signal, index) => (
            <li class="signals-slide min-w-0" data-signal-slide style={`--float-delay: ${index * -1.6}s`}>
              <article class="signal-card flex h-full flex-col overflow-hidden rounded-[1.125rem] border border-outline-variant bg-surface-container-lowest shadow-xl shadow-shadow/20 [overflow-wrap:anywhere] dark:border-primary/20 dark:bg-background dark:shadow-shadow/60">
                <div class="relative aspect-[4/3] shrink-0">
                  <img
                    src={`${assetBase}${signalImages[index].file}`}
                    alt=""
                    width={signalImages[index].width}
                    height={signalImages[index].height}
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                </div>
                <div class="flex flex-1 flex-col p-5 lg:p-6">
                  <h3 class="text-xl leading-snug font-semibold sm:text-lg lg:text-xl">{signal.title}</h3>
                  <p class="mt-3 text-base leading-relaxed text-on-surface-variant">{signal.description}</p>
                </div>
              </article>
            </li>
          ))}
        </ul>
        <div class="signals-controls" data-signals-controls hidden>
          <button type="button" class="signals-nav" data-signals-previous aria-controls="signals-slides" aria-label={previousSignal} disabled>
            <svg class="size-6 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m14 6-6 6 6 6" /></svg>
          </button>
          <button type="button" class="signals-nav" data-signals-next aria-controls="signals-slides" aria-label={nextSignal}>
            <svg class="size-6 shrink-0" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m10 6 6 6-6 6" /></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <section id="exemplo" aria-labelledby="example-title" class="chapter relative isolate overflow-hidden border-b border-primary/45 bg-primary-container dark:border-primary/20 dark:bg-primary-container/30">
    <img src={exampleBackground} alt="" aria-hidden="true" width="640" height="427" loading="lazy" decoding="async" class="pointer-events-none absolute inset-0 h-full w-full object-cover object-[center_40%]" />
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-primary-container/60 dark:bg-background/65"></div>
    <div class="section-container relative z-10 py-16 md:py-20">
      <div class="rounded-[1.75rem] border border-primary/50 bg-surface-container-lowest p-6 dark:border-primary/30 dark:bg-surface-container-low md:p-10">
        <div class="grid gap-9 md:grid-cols-[1fr_1.15fr] md:gap-12">
          <div class="md:pr-1">
            <p data-reveal class="eyebrow">{content.example.label}</p>
            <h2 data-reveal id="example-title" class="section-title">
              {content.example.title.map((line) => <span class="block">{line}</span>)}
            </h2>
            <p data-reveal class="section-description max-w-[35ch]">{content.example.description}</p>
            <figure data-reveal class="mt-9">
              <div class="rounded-2xl bg-primary/15 p-5">
                <p class="text-[0.625rem] leading-relaxed font-semibold tracking-wide text-primary uppercase">{content.example.messageLabel}</p>
                <blockquote class="mt-3 max-w-[36ch] text-lg leading-relaxed">{content.example.message}</blockquote>
              </div>
            </figure>
          </div>
          <div class="border-t border-primary/35 pt-8 text-center md:border-t-0 md:border-l md:pt-2 md:pl-12">
            <p data-reveal class="eyebrow">{content.example.explanationLabel}</p>
            <div data-example-carousel data-reveal class="example-carousel mt-9" role="group" aria-label={content.example.explanationLabel}>
              <ol class="carousel-slides grid gap-6" aria-live="off">
                {content.example.explanations.map((explanation, index) => (
                  <li data-carousel-slide class="rounded-2xl border border-primary/25 bg-primary/5 p-5 sm:p-6">
                    <span class="inline-flex items-center gap-2 text-sm font-medium text-primary">
                      {content.example.stepLabel} <span class="text-2xl font-semibold">{String(index + 1).padStart(2, '0')}</span>
                    </span>
                    <h3 class="mt-5 text-xl leading-snug font-semibold sm:text-2xl">{explanation.title}</h3>
                    <p class="mx-auto mt-3 max-w-[38ch] text-base leading-relaxed text-on-surface-variant sm:text-lg">{explanation.description}</p>
                  </li>
                ))}
              </ol>
              <div data-carousel-controls hidden class="mt-5 items-center justify-center gap-3">
                <div class="flex gap-2">
                  {content.example.explanations.map((explanation, index) => (
                    <button
                      type="button"
                      data-carousel-select={index}
                      aria-label={`${content.example.stepLabel} ${index + 1}: ${explanation.title}`}
                      aria-pressed={index === 0 ? 'true' : 'false'}
                      class="carousel-select grid size-11 cursor-pointer place-items-center rounded-full border border-primary/35 text-sm font-semibold"
                    >{index + 1}</button>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="duvidas" aria-labelledby="faq-title" class="chapter border-b border-outline-variant bg-surface-container-low dark:border-outline-variant/60">
    <div class="section-container grid gap-9 py-16 md:grid-cols-[0.9fr_1.1fr] md:gap-16 md:py-20">
      <div class="md:self-center">
        <p data-reveal class="eyebrow">{content.faq.label}</p>
        <h2 data-reveal id="faq-title" class="section-title">
          {content.faq.title.map((line) => <span class="block">{line}</span>)}
        </h2>
        <p data-reveal class="section-description max-w-[26ch]">{content.faq.description}</p>
      </div>
      <dl>
        {content.faq.items.map((item) => (
          <div data-reveal class="border-b border-outline-variant py-5 first:pt-0">
            <dt class="text-lg leading-snug font-semibold">{item.question}</dt>
            <dd class="mt-3 max-w-[60ch] text-base leading-relaxed text-on-surface-variant lg:text-[1.0625rem]">{item.answer}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="bg-background">
    <div class="section-container py-16 md:py-20">
      <section aria-labelledby="closing-title" class="rounded-[1.75rem] bg-primary-fixed-dim p-6 text-center text-on-primary-fixed md:p-10 lg:text-left">
        <p data-reveal class="text-xs leading-relaxed font-semibold uppercase">{content.closing.label}</p>
        <div class="mt-5 grid items-center gap-x-12 gap-y-7 lg:grid-cols-[minmax(0,1fr)_auto]">
          <h2 data-reveal id="closing-title" class="min-w-0 text-[clamp(1.875rem,3.2vw,3rem)] leading-[1.12] font-semibold tracking-[-0.025em]">
            {content.closing.title.map((line) => <span class="block">{line}</span>)}
          </h2>
          <p data-reveal class="min-w-0 text-base leading-relaxed lg:col-start-1 lg:row-start-2 lg:text-lg">{content.closing.description}</p>
          <a data-reveal href="#como-funciona" class="inline-flex min-h-14 items-center justify-center gap-3 justify-self-center rounded-xl bg-on-primary-fixed px-6 py-3 text-sm font-semibold text-primary-fixed hover:bg-on-primary-fixed/90 lg:col-start-2 lg:row-start-1 lg:justify-self-start">
            <span class="-translate-y-px leading-5">{content.closing.action}</span>
            <svg aria-hidden="true" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 19V5m-6 6 6-6 6 6" />
            </svg>
          </a>
        </div>
      </section>
    </div>
  </div>
</div>

<script>
  import '../scripts/signals-slider';

  document.querySelectorAll<HTMLElement>('[data-example-carousel]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const selectors = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-select]'));
    const controls = carousel.querySelector<HTMLElement>('[data-carousel-controls]');
    if (slides.length < 2 || !controls) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let inView = false;
    let timer: number | undefined;

    const showSlide = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === current;
        slide.toggleAttribute('data-active', active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      selectors.forEach((button, index) => button.setAttribute('aria-pressed', String(index === current)));
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (reducedMotion.matches || !inView || document.hidden) return;
      timer = window.setTimeout(() => {
        showSlide(current + 1);
        schedule();
      }, 5000);
    };

    selectors.forEach((button, index) => button.addEventListener('click', () => {
      showSlide(index);
      schedule();
    }));
    document.addEventListener('visibilitychange', schedule);
    reducedMotion.addEventListener('change', schedule);

    showSlide(0);
    carousel.setAttribute('data-carousel-ready', '');
    controls.hidden = false;

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        schedule();
      }, { threshold: 0.2 });
      observer.observe(carousel);
    } else {
      inView = true;
      schedule();
    }
  });
</script>

<style>
  .signals-slider {
    position: relative;
    max-width: 52rem;
    margin-inline: auto;
  }

  .signals-track {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 1.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-block: 0.5rem 1.5rem;
  }

  .signals-slide {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .signals-track::-webkit-scrollbar {
    display: none;
  }

  .signals-track:focus-visible {
    outline: 2px solid var(--md-sys-color-primary);
    outline-offset: 0.25rem;
    border-radius: 1.125rem;
  }

  .signals-controls {
    position: absolute;
    top: 0.5rem;
    inset-inline: 0.25rem;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    aspect-ratio: 4 / 3;
    pointer-events: none;
  }

  .signals-controls[hidden] {
    display: none;
  }

  .signals-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 3.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: white;
    pointer-events: auto;
    filter: drop-shadow(0 1px 3px rgb(0 0 0 / 85%));
    cursor: pointer;
  }

  .signals-nav:enabled:hover {
    color: var(--md-sys-color-primary);
  }

  .signals-nav:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  @media (width >= 40rem) {
    .signals-slider {
      max-width: none;
    }

    .signals-track {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
      overflow: visible;
      scroll-snap-type: none;
      padding-block: 1.25rem 2.5rem;
    }

    .signals-controls {
      display: none;
    }
  }

  @media (width >= 64rem) {
    .signals-track {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (width >= 64rem) and (prefers-reduced-motion: no-preference) {
    .signal-card {
      animation: signal-float 6.4s ease-in-out infinite;
      animation-delay: var(--float-delay, 0s);
    }
  }

  @keyframes signal-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  [data-carousel-controls]:not([hidden]) {
    display: flex;
  }

  [data-carousel-ready] .carousel-slides {
    gap: 0;
  }

  [data-carousel-ready] [data-carousel-slide] {
    grid-area: 1 / 1;
    align-self: stretch;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    translate: 1rem 0;
  }

  [data-carousel-ready] [data-carousel-slide][data-active] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    translate: none;
  }

  .carousel-select[aria-pressed='true'] {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }

  .carousel-select[aria-pressed='false'] {
    color: var(--md-sys-color-primary);
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-carousel-ready] [data-carousel-slide] {
      transition: opacity 450ms ease, translate 450ms ease, visibility 450ms;
    }
  }

  .section-container {
    width: 100%;
    max-width: 84rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  @media (width >= 40rem) {
    .section-container {
      padding-inline: 2rem;
    }
  }

  @media (width >= 64rem) {
    .section-container {
      padding-inline: 3rem;
    }
  }

  .chapter {
    scroll-margin-top: 8rem;
  }

  .eyebrow {
    color: var(--md-sys-color-primary);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .section-title {
    margin-top: 1.25rem;
    font-size: clamp(1.875rem, 3vw, 2.75rem);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.025em;
    overflow-wrap: break-word;
  }

  .section-description {
    margin-top: 1.25rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 1.125rem;
    line-height: 1.6;
  }
</style>
