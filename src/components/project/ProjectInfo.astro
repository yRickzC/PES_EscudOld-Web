---
import type { ProjectContent } from '../../i18n/project';
import type { ProjectStatisticGroup } from '../../i18n/project-stats';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
  content: ProjectContent['info'];
  groups: ProjectStatisticGroup[];
}

const { locale, content, groups } = Astro.props;
const numberLocale = locale === 'pt-br' ? 'pt-BR' : 'en-US';
const decimalSeparator = locale === 'pt-br' ? ',' : '.';
const groupingSeparator = locale === 'pt-br' ? /\./g : /,/g;
const statistics = groups.flatMap((group) => group.items.map((item) => {
  const parts = item.value.match(/^(.*?)(\d[\d.,]*)(.*)$/);
  const rawNumber = parts?.[2] ?? '';

  return {
    ...item,
    category: group.title,
    prefix: parts?.[1] ?? '',
    rawNumber,
    suffix: parts?.[3] ?? '',
    target: Number(rawNumber.replace(groupingSeparator, '').replace(decimalSeparator, '.')),
    decimals: rawNumber.split(decimalSeparator)[1]?.length ?? 0,
  };
}));
---

<section id="info" class="project-info" aria-labelledby="project-context-title">
  <div class="project-stats" data-project-stats data-number-locale={numberLocale} style={`--project-stats-duration: ${statistics.length * 9}s`}>
    <div id="project-stats-window" class="project-stats-window" role="region" aria-label={content.statsLabel} tabindex="0">
      <div class="project-stats-track">
        {[0, 1].map((copy) => (
          <div class:list={['project-stats-group', { 'project-stats-copy': copy === 1 }]} aria-hidden={copy === 1 ? 'true' : undefined}>
            {statistics.map((statistic) => (
              <article class="project-stat" data-stat-card>
                <p class="sr-only">{statistic.category}</p>
                <h2 class="project-stat-label">{statistic.label}</h2>
                <p class="project-stat-value">
                  <span class="sr-only">{statistic.value}</span>
                  <span aria-hidden="true">{statistic.prefix}<span data-stat-number data-value={statistic.target} data-decimals={statistic.decimals}>{statistic.rawNumber}</span>{statistic.suffix}</span>
                </p>
              </article>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="project-container project-context project-split">
    <div>
      <p data-reveal class="project-eyebrow">{content.context}</p>
      <h1 id="project-context-title" data-reveal class="project-title">{content.contextTitle}</h1>
    </div>
    <p data-reveal class="project-description">{content.contextDescription}</p>
  </div>
</section>

<script>
  import '../../scripts/project-stats';
</script>
