---
import type { ProjectContent } from '../../i18n/project';
import ProjectRoadmap from './ProjectRoadmap.astro';

interface Props {
  project: ProjectContent['project'];
  roadmap: ProjectContent['roadmap'];
}

const { project, roadmap } = Astro.props;
---

<section id="projeto" class="project-section project-container" aria-labelledby="project-overview-title">
  <div class="project-split">
    <header>
      <div data-reveal class="project-topic">
        <p class="project-eyebrow">{project.label}</p>
        <p class="project-status">{project.status}</p>
      </div>
      <h2 data-reveal id="project-overview-title" class="project-title">{project.title.map((line) => <span>{line}</span>)}</h2>
      <p data-reveal class="project-description">{project.description}</p>
    </header>
    <ol class="project-flow" role="list">
      {project.items.map((item, index) => (
        <li data-reveal>
          <span class="project-flow-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3>{item.title}</h3>
            <p class="project-muted">{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<ProjectRoadmap content={roadmap} />
