---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../i18n/ui';
import { landingContent } from '../i18n/landing';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const how = landingContent[locale].how;
const scrollHint = locale === 'pt-br'
  ? 'Role para acompanhar as mensagens. Com o foco nesta área, use as setas para trocar a mensagem.'
  : 'Scroll to follow the messages. When this area is focused, use the arrow keys to change the message.';
const projectHref = getRelativeLocaleUrl(locale, locale === 'pt-br' ? 'sobre-o-projeto/' : 'about-the-project/');
const assetBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/`;
const avatarFiles = ['Avatar01.gif', 'Avatar02.gif', 'Avatar03.gif'];
const phoneVideos = [
  { phase: 1, sources: [{ file: 'inicial.mp4', type: 'video/mp4' }] },
  { phase: 2, sources: [{ file: 'anim02.mp4', type: 'video/mp4' }] },
  { phase: 3, sources: [{ file: 'anim-final.mp4', type: 'video/mp4' }] },
];
---

<section class="hero relative isolate" aria-labelledby="hero-title" data-phone-story>
  <div class="hero-light pointer-events-none absolute inset-x-0 -top-36 -z-10 h-[44rem] overflow-hidden" aria-hidden="true"></div>

  <div class="mx-auto max-w-5xl px-5 pt-14 text-center sm:px-8 sm:pt-22 lg:pt-25" data-story-intro>
    <h1 data-reveal id="hero-title" class="text-[clamp(2.5rem,7.4vw,5.5rem)] leading-[0.99] font-medium tracking-[-0.06em] text-on-surface">
      {t('titleFirst')} <span class="block">{t('titleSecond')}</span>
    </h1>
    <p data-reveal class="mx-auto mt-6 max-w-[34rem] text-base leading-relaxed text-on-surface-variant sm:text-lg">
      {t('description')}
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a data-reveal href={projectHref} class="inline-flex min-h-12 items-center justify-center rounded-xl border border-primary bg-primary px-5 py-3 text-sm font-semibold text-on-primary shadow-[0_0_30px] shadow-primary/25 hover:bg-primary/90 sm:text-base">
        {t('discover')}
      </a>
      <a data-reveal href="#exemplo" class="inline-flex min-h-12 items-center justify-center gap-2.5 rounded-xl border border-primary/35 bg-surface-container-low/70 px-5 py-3 text-sm font-semibold text-on-surface hover:border-primary hover:bg-surface-container-high sm:text-base">
        <span class="chat-mark" aria-hidden="true"></span>
        {t('example')}
      </a>
    </div>
  </div>

  <div class="phone-launch relative mx-auto mt-6 flex max-w-5xl items-start justify-center px-4" data-phone-launch>
    <div class="stage-halo pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true"></div>
    <div class="phone-traveler" data-story-phone>
      <div class="phone-frame relative w-full rounded-[2.25rem] border border-outline bg-surface-container-lowest p-2 shadow-2xl shadow-shadow/40 ring-4 ring-primary/8">
        <div class="phone-screen relative rounded-[1.75rem] border border-outline-variant" role="img" aria-label={t('phoneImageDescription')}>
          <div class="phone-notch" aria-hidden="true"></div>
          {phoneVideos.map((video, index) => (
            <video
              class="phone-video"
              data-phone-video={video.phase}
              data-video-visible={index === 0 ? '' : undefined}
              muted
              playsinline
              preload={index === 0 ? 'auto' : 'metadata'}
              disablepictureinpicture
              tabindex="-1"
              aria-hidden="true"
            >
              {video.sources.map((source) => <source src={`${assetBase}${source.file}`} type={source.type} />)}
            </video>
          ))}
        </div>
      </div>
    </div>
  </div>

  <section id="como-funciona" aria-labelledby="how-title" class="how-section text-on-surface" data-how-section>
    <div class="mx-auto w-full max-w-[84rem] px-6 sm:px-8 lg:px-12">
      <div class="how-heading mx-auto max-w-4xl text-center" data-how-heading>
        <div class="how-heading-content">
          <p class="text-xs leading-relaxed font-semibold text-primary uppercase">{how.label}</p>
          <h2 id="how-title" class="mt-5 text-[clamp(1.875rem,3vw,2.75rem)] leading-[1.14] font-medium tracking-[-0.025em]">{how.title}</h2>
          <p class="mt-5 text-lg leading-relaxed text-on-surface-variant">{how.description}</p>
        </div>
      </div>
      <div class="how-scroll-track" data-how-track>
        <p id="how-scroll-help" class="sr-only" data-scroll-help hidden>{scrollHint}</p>
        <div class="how-scene" data-how-scene role="group" aria-labelledby="how-title">
          <div class="phone-dock" data-phone-dock></div>
          <ol class="how-exchanges">
            {how.steps.map((step, index) => (
              <li class="how-exchange" data-how-exchange>
                <div class="how-avatar" aria-hidden="true">
                  <img src={`${assetBase}${avatarFiles[index]}`} alt="" loading="lazy" decoding="async" />
                </div>
                <article class="how-message rounded-[1.125rem] border border-outline-variant bg-surface-container-low p-5 dark:border-primary/20 lg:p-6" aria-labelledby={`how-message-title-${index + 1}`}>
                  <h3 id={`how-message-title-${index + 1}`} class="text-[1.375rem] leading-snug font-semibold">{step.title}</h3>
                  <p class="mt-3 text-base leading-relaxed text-on-surface-variant lg:text-[1.0625rem]">{step.description}</p>
                  <div class="mt-5 rounded-xl bg-primary/10 px-3 py-3">
                    <p class="text-[0.625rem] leading-relaxed font-semibold tracking-wide text-primary uppercase">{step.label}</p>
                    <p class="mt-1 text-sm leading-relaxed">{step.example}</p>
                  </div>
                </article>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>
</section>

<script>
  import '../scripts/hero-story';
</script>

<style>
  .hero {
    --phone-width: min(84vw, 46vh, 24rem);
    --dock-width: calc(var(--phone-width) * 0.72);
  }

  .phone-launch {
    height: calc(var(--phone-width) * 2 + 2rem);
    padding-block: 1rem;
  }

  .phone-traveler {
    width: var(--phone-width);
    flex-shrink: 0;
  }

  .phone-frame {
    display: flex;
    aspect-ratio: 9 / 18;
  }

  .how-section {
    padding-block: 4rem;
    scroll-margin-top: 2rem;
  }

  .how-scroll-track {
    margin-top: 3rem;
  }

  .how-scene:focus-visible {
    outline: 2px solid var(--md-sys-color-primary);
    outline-offset: 0.75rem;
    border-radius: 1.5rem;
  }

  .phone-dock {
    position: relative;
    display: none;
    width: var(--dock-width);
    aspect-ratio: 9 / 18;
    justify-self: center;
    align-self: center;
  }

  .how-exchanges {
    display: grid;
    gap: 2rem;
    min-width: 0;
  }

  .how-exchange {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    min-width: 0;
  }

  .how-avatar {
    justify-self: center;
    width: min(100%, 14rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: 1.5rem;
    background: var(--md-sys-color-surface-container-low);
  }

  .how-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .how-message {
    min-width: 0;
  }

  [data-story-ready] .phone-traveler {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 50%;
    transform-origin: top center;
    transform: translate3d(calc(-50% + var(--phone-x, 0px)), var(--phone-travel, 0px), 0) scale(var(--phone-scale, 1));
    will-change: transform;
  }

  [data-story-ready] .phone-dock {
    display: block;
  }

  [data-story-ready] .stage-halo {
    opacity: calc(1 - var(--story-progress, 0));
  }

  [data-story-ready] .how-heading-content {
    opacity: var(--how-heading-opacity, 0);
    transform: translateY(var(--how-heading-y, 0px));
  }

  [data-story-ready] .how-scroll-track {
    height: calc(var(--scene-height) + var(--scroll-space));
  }

  [data-story-ready] .how-scene {
    position: sticky;
    top: var(--scene-top, 1.5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: calc(var(--dock-width) * 2) auto;
    gap: 1.5rem;
  }

  [data-story-ready] .phone-dock {
    grid-area: 1 / 2;
    justify-self: start;
  }

  [data-story-ready] .how-exchanges {
    grid-area: 1 / 1 / 3 / -1;
    gap: 0;
    overflow: clip;
    opacity: var(--exchanges-open, 0);
  }

  [data-story-ready] .how-exchange {
    grid-area: 1 / 1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: calc(var(--dock-width) * 2) auto;
    pointer-events: none;
  }

  [data-story-ready] .how-exchange[data-current] {
    pointer-events: auto;
  }

  [data-story-ready] .how-avatar,
  [data-story-ready] .how-message {
    opacity: var(--exchange-opacity, 0);
    transform: translateY(var(--exchange-y, 0px));
    will-change: transform, opacity;
  }

  [data-story-ready] .how-avatar {
    grid-area: 1 / 1;
    width: var(--dock-width);
    justify-self: end;
  }

  [data-story-ready] .how-message {
    grid-area: 2 / 1 / 3 / -1;
  }

  @media (width < 40rem) {
    .how-avatar {
      display: none;
    }

    [data-story-ready] {
      --dock-width: min(60vw, 27vh, 15rem);
      --dock-width: min(60vw, 27svh, 15rem);
    }

    [data-story-ready] .how-scene,
    [data-story-ready] .how-exchange {
      grid-template-columns: minmax(0, 1fr);
    }

    [data-story-ready] .phone-dock {
      grid-area: 1 / 1;
      justify-self: center;
    }
  }

  @media (40rem <= width < 64rem) {
    [data-story-ready] {
      --dock-width: min(calc(var(--phone-width) * 0.6), 10rem);
    }
  }

  @media (width >= 64rem) {
    .how-section {
      padding-block: 5rem;
    }

    .how-exchange {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    }

    [data-story-ready] .how-scene,
    [data-story-ready] .how-exchange {
      grid-template-columns: minmax(0, 1fr) var(--dock-width) minmax(0, 1fr);
      grid-template-rows: auto;
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }

    [data-story-ready] .phone-dock {
      grid-area: 1 / 2;
    }

    [data-story-ready] .how-exchanges {
      grid-area: 1 / 1 / 2 / -1;
    }

    [data-story-ready] .how-avatar {
      width: min(100%, 16rem);
      justify-self: center;
    }

    [data-story-ready] .how-message {
      grid-area: 1 / 3;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .phone-frame {
      animation: phone-float 5s ease-in-out infinite;
    }

    .phone-traveler:focus-within .phone-frame {
      animation-play-state: paused;
    }
  }

  @keyframes phone-float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-0.5rem);
    }
  }

  .hero-light {
    background:
      radial-gradient(ellipse 33rem 27rem at 18% 8%, color-mix(in srgb, var(--md-sys-color-primary) 22%, transparent), transparent 100%),
      radial-gradient(ellipse 24rem 22rem at 12% 2%, color-mix(in srgb, var(--md-sys-color-primary-container) 65%, transparent), transparent 100%);
    mask-image: linear-gradient(black 52%, transparent 100%);
  }

  .hero-light::before {
    position: absolute;
    top: -23rem;
    left: -9rem;
    width: 43rem;
    height: 46rem;
    background:
      linear-gradient(to right, var(--md-sys-color-primary) 1px, transparent 1px) 0 0 / 4.5rem 4.5rem,
      linear-gradient(to bottom, var(--md-sys-color-primary) 1px, transparent 1px) 0 0 / 4.5rem 4.5rem;
    content: "";
    mask-image: radial-gradient(ellipse at 50% 53%, black, transparent 65%);
    opacity: 0.19;
    transform: perspective(38rem) rotateX(25deg) rotateZ(-24deg);
  }

  .hero-light::after {
    position: absolute;
    top: 11rem;
    right: 8%;
    width: min(16rem, 32vw);
    height: 15rem;
    background: radial-gradient(circle, var(--md-sys-color-primary) 1px, transparent 1.5px) 0 0 / 2.25rem 2.25rem;
    content: "";
    mask-image: radial-gradient(ellipse, black, transparent 70%);
    opacity: 0.28;
  }

  .stage-halo {
    background: radial-gradient(ellipse at 50% 63%, color-mix(in srgb, var(--md-sys-color-primary) 22%, transparent), transparent 63%);
    mask-image: linear-gradient(black 68%, transparent);
  }

  .stage-halo::before {
    position: absolute;
    top: 0.5rem;
    left: 50%;
    width: min(92%, 44rem);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--md-sys-color-primary) 17%, transparent);
    border-radius: 50%;
    background: linear-gradient(color-mix(in srgb, var(--md-sys-color-primary) 9%, transparent), transparent 56%);
    content: "";
    transform: translateX(-50%);
  }

  .phone-screen {
    flex: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: #000;
  }

  .phone-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    pointer-events: none;
  }

  .phone-video[data-video-visible] {
    opacity: 1;
  }

  .phone-notch {
    position: absolute;
    z-index: 1;
    top: 0.5rem;
    left: 50%;
    width: 4rem;
    height: 0.875rem;
    border-radius: 999px;
    background: #202526;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .chat-mark {
    position: relative;
    display: block;
    width: 0.95rem;
    height: 0.75rem;
    border: 1.5px solid currentColor;
    border-radius: 0.25rem;
  }

  .chat-mark::after {
    position: absolute;
    bottom: -0.15rem;
    left: 0.14rem;
    width: 0.24rem;
    height: 0.24rem;
    border-bottom: 1.5px solid currentColor;
    border-left: 1.5px solid currentColor;
    background: var(--md-sys-color-surface-container-low);
    content: "";
    transform: skewY(-35deg);
  }
</style>
