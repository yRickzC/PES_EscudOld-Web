---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ImagePlaceholder from './ImagePlaceholder.astro';
import { useTranslations, type Locale } from '../i18n/ui';
import { landingContent } from '../i18n/landing';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const how = landingContent[locale].how;
const stepLabel = landingContent[locale].example.stepLabel;
const projectHref = getRelativeLocaleUrl(locale, locale === 'pt-br' ? 'sobre-o-projeto/' : 'about-the-project/');
---

<section class="hero relative isolate" aria-labelledby="hero-title" data-phone-story>
  <div class="hero-light pointer-events-none absolute inset-x-0 -top-36 -z-10 h-[44rem] overflow-hidden" aria-hidden="true"></div>

  <div class="mx-auto max-w-5xl px-5 pt-14 text-center sm:px-8 sm:pt-22 lg:pt-25" data-story-intro>
    <h1 data-reveal id="hero-title" class="text-[clamp(2.5rem,7.4vw,5.5rem)] leading-[0.99] font-medium tracking-[-0.06em] text-on-surface">
      {t('titleFirst')} <span class="block">{t('titleSecond')}</span>
    </h1>
    <p data-reveal class="mx-auto mt-6 max-w-[34rem] text-base leading-relaxed text-on-surface-variant sm:text-lg">
      {t('description')}
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a data-reveal href={projectHref} class="inline-flex min-h-12 items-center justify-center rounded-xl border border-primary bg-primary px-5 py-3 text-sm font-semibold text-on-primary shadow-[0_0_30px] shadow-primary/25 hover:bg-primary/90 sm:text-base">
        {t('discover')}
      </a>
      <a data-reveal href="#exemplo" class="inline-flex min-h-12 items-center justify-center gap-2.5 rounded-xl border border-primary/35 bg-surface-container-low/70 px-5 py-3 text-sm font-semibold text-on-surface hover:border-primary hover:bg-surface-container-high sm:text-base">
        <span class="chat-mark" aria-hidden="true"></span>
        {t('example')}
      </a>
    </div>
  </div>

  <div class="phone-launch relative mx-auto mt-6 flex max-w-5xl items-start justify-center px-4" data-phone-launch>
    <div class="stage-halo pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true"></div>
    <div class="phone-traveler" data-story-phone>
      <div class="phone-frame relative w-full rounded-[2.25rem] border border-outline bg-surface-container-lowest p-2 shadow-2xl shadow-shadow/40 ring-4 ring-primary/8">
        <div class="phone-screen rounded-[1.75rem] border border-outline-variant bg-surface-container-low px-3 pt-2 pb-3">
          <div class="mx-auto h-3.5 w-16 rounded-full bg-surface-container-highest" aria-hidden="true"></div>
          <div class="mt-4 border-b border-outline-variant/75 pb-3 leading-tight" aria-hidden="true">
            <p class="text-sm font-semibold text-on-surface">EscudOld</p>
            <p class="mt-0.5 text-xs text-on-surface-variant">WhatsApp</p>
          </div>
          <ImagePlaceholder id="phone-image-description" name={t('phoneImage')} description={t('phoneImageDescription')} />
        </div>
      </div>
    </div>
  </div>

  <section id="como-funciona" aria-labelledby="how-title" class="how-section text-on-surface" data-how-section>
    <div class="mx-auto w-full max-w-[84rem] px-6 sm:px-8 lg:px-12">
      <div class="how-heading mx-auto max-w-4xl text-center" data-how-heading>
        <div class="how-heading-content">
          <p class="text-xs leading-relaxed font-semibold text-primary uppercase">{how.label}</p>
          <h2 id="how-title" class="mt-5 text-[clamp(1.875rem,3vw,2.75rem)] leading-[1.14] font-medium tracking-[-0.025em]">{how.title}</h2>
          <p class="mt-5 text-lg leading-relaxed text-on-surface-variant">{how.description}</p>
        </div>
      </div>
      <div class="how-layout">
        <div class="phone-dock" data-phone-dock aria-hidden="true"></div>
        <div class="how-steps" data-how-steps>
          <div class="how-step-header" data-step-controls hidden>
            <div class="flex gap-1.5" role="tablist" aria-label={how.label}>
              {how.steps.map((step, index) => (
                <button
                  id={`how-step-tab-${index + 1}`}
                  type="button"
                  role="tab"
                  aria-label={`${stepLabel} ${index + 1}: ${step.title}`}
                  aria-controls={`how-step-panel-${index + 1}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? 0 : -1}
                  class="how-step-tab grid size-11 shrink-0 cursor-pointer place-items-center rounded-full border border-primary/35 text-sm font-semibold"
                >{index + 1}</button>
              ))}
            </div>
            <h3 class="text-lg leading-snug font-semibold" data-current-step-title>{how.steps[0].title}</h3>
          </div>
          <div class="how-cards" role="list" data-step-panels>
            {how.steps.map((step, index) => (
              <div
                id={`how-step-panel-${index + 1}`}
                role="listitem"
                aria-labelledby={`how-step-title-${index + 1}`}
                data-step-panel
                class="how-card flex flex-col rounded-[1.125rem] border border-outline-variant bg-surface-container-low p-5 dark:border-primary/20 lg:p-6"
              >
                <span class="how-card-number text-[2rem] leading-none font-medium text-primary" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <h3 id={`how-step-title-${index + 1}`} class="how-card-title mt-6 text-[1.375rem] leading-snug font-semibold">{step.title}</h3>
                <p class="how-card-description mt-2 mb-4 text-base leading-relaxed text-on-surface-variant lg:text-[1.0625rem]">{step.description}</p>
                <div class="mt-auto rounded-xl bg-primary/10 px-3 py-3">
                  <p class="text-[0.625rem] leading-relaxed font-semibold tracking-wide text-primary uppercase">{step.label}</p>
                  <p class="mt-1 text-sm leading-relaxed">{step.example}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</section>

<script>
  import '../scripts/hero-story';
  import '../scripts/how-steps';
</script>

<style>
  .hero {
    --phone-width: min(84vw, 46vh, 24rem);
    --dock-width: calc(var(--phone-width) * 0.72);
  }

  .phone-launch {
    height: calc(var(--phone-width) * 2 + 2rem);
    padding-block: 1rem;
  }

  .phone-traveler {
    width: var(--phone-width);
    flex-shrink: 0;
  }

  .phone-frame {
    display: flex;
    aspect-ratio: 9 / 18;
  }

  .how-section {
    padding-block: 4rem;
    scroll-margin-top: 2rem;
  }

  .how-layout {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
  }

  .phone-dock {
    display: none;
    width: var(--dock-width);
    aspect-ratio: 9 / 18;
    justify-self: center;
    align-self: center;
  }

  .how-cards {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }

  .how-card {
    min-width: 0;
  }

  .how-steps {
    min-width: 0;
  }

  .how-step-header {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .how-step-header[hidden],
  .how-card[hidden] {
    display: none;
  }

  .how-step-tab[aria-selected='true'] {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }

  .how-step-tab[aria-selected='false'] {
    color: var(--md-sys-color-primary);
  }

  .how-step-tab:hover {
    border-color: var(--md-sys-color-primary);
  }

  [data-mobile-steps] .how-card-number,
  [data-mobile-steps] .how-card-title {
    display: none;
  }

  [data-mobile-steps] .how-card-description {
    margin-top: 0;
  }

  [data-story-ready] .phone-traveler {
    position: absolute;
    z-index: 2;
    top: 1rem;
    left: 50%;
    transform-origin: top center;
    transform: translate3d(-50%, var(--phone-travel, 0px), 0) scale(var(--phone-scale, 1));
    will-change: transform;
  }

  [data-story-ready] .phone-dock {
    display: block;
  }

  [data-story-ready] .stage-halo {
    opacity: calc(1 - var(--story-progress, 0));
  }

  [data-story-ready] .how-heading-content {
    opacity: var(--how-heading-opacity, 0);
    transform: translateY(var(--how-heading-y, 0px));
  }

  [data-story-ready] .how-card,
  [data-story-ready] .how-step-header {
    opacity: var(--cards-open, 0);
    transform: translateY(calc((1 - var(--cards-open, 0)) * -4rem));
  }

  @media (width >= 64rem) {
    .how-section {
      padding-block: 5rem;
    }

    .how-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    [data-story-ready] .phone-dock,
    [data-story-ready] .how-steps {
      grid-area: 1 / 1;
    }

    [data-story-ready] .how-cards {
      grid-template-columns: minmax(0, 1fr) var(--dock-width) minmax(0, 1fr);
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }

    [data-story-ready] .how-card {
      --card-direction: 1;
      transform: translateX(calc((1 - var(--cards-open, 0)) * var(--card-direction) * 3rem));
    }

    [data-story-ready] .how-card:nth-child(1) {
      grid-column: 1;
      grid-row: 1;
    }

    [data-story-ready] .how-card:nth-child(2) {
      --card-direction: -1;
      grid-column: 3;
      grid-row: 1;
    }

    [data-story-ready] .how-card:nth-child(3) {
      grid-column: 1;
      grid-row: 2;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .phone-frame {
      animation: phone-float 5s ease-in-out infinite;
    }

    .phone-traveler:focus-within .phone-frame {
      animation-play-state: paused;
    }
  }

  @keyframes phone-float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-0.5rem);
    }
  }

  .hero-light {
    background:
      radial-gradient(ellipse 33rem 27rem at 18% 8%, color-mix(in srgb, var(--md-sys-color-primary) 22%, transparent), transparent 100%),
      radial-gradient(ellipse 24rem 22rem at 12% 2%, color-mix(in srgb, var(--md-sys-color-primary-container) 65%, transparent), transparent 100%);
    mask-image: linear-gradient(black 52%, transparent 100%);
  }

  .hero-light::before {
    position: absolute;
    top: -23rem;
    left: -9rem;
    width: 43rem;
    height: 46rem;
    background:
      linear-gradient(to right, var(--md-sys-color-primary) 1px, transparent 1px) 0 0 / 4.5rem 4.5rem,
      linear-gradient(to bottom, var(--md-sys-color-primary) 1px, transparent 1px) 0 0 / 4.5rem 4.5rem;
    content: "";
    mask-image: radial-gradient(ellipse at 50% 53%, black, transparent 65%);
    opacity: 0.19;
    transform: perspective(38rem) rotateX(25deg) rotateZ(-24deg);
  }

  .hero-light::after {
    position: absolute;
    top: 11rem;
    right: 8%;
    width: min(16rem, 32vw);
    height: 15rem;
    background: radial-gradient(circle, var(--md-sys-color-primary) 1px, transparent 1.5px) 0 0 / 2.25rem 2.25rem;
    content: "";
    mask-image: radial-gradient(ellipse, black, transparent 70%);
    opacity: 0.28;
  }

  .stage-halo {
    background: radial-gradient(ellipse at 50% 63%, color-mix(in srgb, var(--md-sys-color-primary) 22%, transparent), transparent 63%);
    mask-image: linear-gradient(black 68%, transparent);
  }

  .stage-halo::before {
    position: absolute;
    top: 0.5rem;
    left: 50%;
    width: min(92%, 44rem);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--md-sys-color-primary) 17%, transparent);
    border-radius: 50%;
    background: linear-gradient(color-mix(in srgb, var(--md-sys-color-primary) 9%, transparent), transparent 56%);
    content: "";
    transform: translateX(-50%);
  }

  .phone-screen {
    flex: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background-image: radial-gradient(ellipse at top right, color-mix(in srgb, var(--md-sys-color-primary) 12%, transparent), transparent 65%);
  }

  .chat-mark {
    position: relative;
    display: block;
    width: 0.95rem;
    height: 0.75rem;
    border: 1.5px solid currentColor;
    border-radius: 0.25rem;
  }

  .chat-mark::after {
    position: absolute;
    bottom: -0.15rem;
    left: 0.14rem;
    width: 0.24rem;
    height: 0.24rem;
    border-bottom: 1.5px solid currentColor;
    border-left: 1.5px solid currentColor;
    background: var(--md-sys-color-surface-container-low);
    content: "";
    transform: skewY(-35deg);
  }
</style>
