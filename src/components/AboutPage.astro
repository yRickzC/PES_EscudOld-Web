---
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutContent, teamMembers } from '../i18n/about';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = aboutContent[locale];
const assetsBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets`;
---

<BaseLayout locale={locale} title={content.pageTitle} description={content.description} page="team">
  <section class="about-page" aria-labelledby="about-title">
    <header class="about-introduction">
      <h1 id="about-title">{content.title}</h1>
      <p>{content.introduction}</p>
    </header>

    <div class="team-list">
      {teamMembers.map((member) => (
        <article class="team-card" aria-labelledby={`${member.id}-name`}>
          <div class="team-photo-frame">
            {member.photo ? (
              <img
                class="team-photo"
                src={`${assetsBase}/${member.photo}`}
                alt={`${content.photoOf} ${member.name}`}
                style={`object-position: ${member.photoPosition ?? 'center'};`}
                width="640"
                height="480"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="team-photo-placeholder" role="img" aria-label={`${content.photoPlaceholder}: ${member.name}`}>
                <svg aria-hidden="true" viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="40" cy="28" r="12" />
                  <path d="M16 66v-4a24 24 0 0 1 48 0v4" />
                </svg>
                <span aria-hidden="true">{content.photoPlaceholder}</span>
              </div>
            )}
          </div>

          <div class="team-content">
            <h2 id={`${member.id}-name`}>
              {member.name}
              {member.nickname && <span class="team-nickname"> ({member.nickname})</span>}
            </h2>
            <div class="team-description">
              {member.description[locale].map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <nav class="team-profiles" aria-label={`${content.profilesOf} ${member.name}`}>
              <ul>
                {member.links.map((link) => {
                  const label = link.label === 'Site' ? content.website : link.label;
                  return (
                    <li>
                      <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${label}: ${member.name} (${content.newTab})`}>
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                          {link.label === 'Site' ? (
                            <>
                              <circle cx="12" cy="12" r="9" />
                              <ellipse cx="12" cy="12" rx="4" ry="9" />
                              <path d="M3 12h18" />
                            </>
                          ) : link.label === 'Instagram' ? (
                            <>
                              <rect x="3" y="3" width="18" height="18" rx="5" />
                              <circle cx="12" cy="12" r="4" />
                              <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none" />
                            </>
                          ) : (
                            <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 19 4.77 5.07 5.07 0 0 0 18.91 1S17.73.65 15 2.48a13.38 13.38 0 0 0-7 0C5.27.65 4.09 1 4.09 1A5.07 5.07 0 0 0 4 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 8 18.13V22" />
                          )}
                        </svg>
                        {label}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </nav>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    max-width: 84rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 5rem) 1.5rem clamp(4rem, 8vw, 7rem);
  }

  .about-introduction {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .about-introduction h1 {
    margin: 0;
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .about-introduction > p {
    max-width: 42ch;
    margin: 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .team-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .team-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: 1.5rem;
    background: var(--md-sys-color-surface-container-low);
  }

  .team-photo-frame {
    position: relative;
    min-width: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  .team-photo {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .team-photo-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 0.75rem;
    padding: 1.5rem;
    text-align: center;
  }

  .team-photo-placeholder > svg {
    width: 5rem;
    height: 5rem;
  }

  .team-photo-placeholder > span {
    font-size: 0.9375rem;
  }

  .team-content {
    min-width: 0;
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }

  .team-content h2 {
    margin: 0 0 1.25rem;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .team-nickname {
    color: var(--md-sys-color-primary);
    white-space: nowrap;
  }

  .team-description {
    display: grid;
    gap: 1rem;
    max-width: 65ch;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 1rem;
    line-height: 1.8;
    overflow-wrap: break-word;
  }

  .team-description p {
    margin: 0;
  }

  .team-profiles {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .team-profiles ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .team-profiles a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    color: var(--md-sys-color-primary);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .team-profiles a:hover {
    color: var(--md-sys-color-on-surface);
  }

  .team-profiles svg {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .about-page {
      padding-inline: 2rem;
    }
  }

  @media (min-width: 768px) {
    .team-card {
      grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1.7fr);
    }

    .team-photo-frame {
      grid-column: 1;
      grid-row: 1;
      min-height: 20rem;
      aspect-ratio: auto;
      border-bottom: 0;
      border-right: 1px solid var(--md-sys-color-outline-variant);
    }

    .team-content {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      padding: clamp(1.75rem, 4vw, 3rem);
    }

    .team-card:nth-child(even) {
      grid-template-columns: minmax(0, 1.7fr) minmax(14rem, 0.8fr);
    }

    .team-card:nth-child(even) .team-photo-frame {
      grid-column: 2;
      border-right: 0;
      border-left: 1px solid var(--md-sys-color-outline-variant);
    }

    .team-card:nth-child(even) .team-content {
      grid-column: 1;
    }
  }

  @media (min-width: 1024px) {
    .about-page {
      padding-inline: 3rem;
    }

    .about-introduction {
      grid-template-columns: 1fr 1fr;
      align-items: end;
      gap: 3rem;
    }
  }
</style>
